<article-meta><article-id pub-id-type="pmid">39487157</article-id><article-id pub-id-type="pmc">11530435</article-id><article-id pub-id-type="publisher-id">76773</article-id><article-id pub-id-type="doi">10.1038/s41598-024-76773-4</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Resistome analysis of wastewater treatment plants in Agadir city, Morocco, using a metagenomics approach</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Wardi</surname><given-names>Maryem</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Lemkhente</surname><given-names>Zohra</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Alla</surname><given-names>Aicha Ait</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Slimani</surname><given-names>Noureddine</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Abali</surname><given-names>M&#x02019;hamed</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Idaghdour</surname><given-names>Youssef</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Belmouden</surname><given-names>Ahmed</given-names></name><address><email>a.belmouden@uiz.ac.ma</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/006sgpv47</institution-id><institution-id institution-id-type="GRID">grid.417651.0</institution-id><institution-id institution-id-type="ISNI">0000 0001 2156 6183</institution-id><institution>Laboratory of Cellular Biology and Molecular Genetics, Faculty of Sciences, </institution><institution>Ibnou Zohr University, </institution></institution-wrap>Agadir, Morocco </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/006sgpv47</institution-id><institution-id institution-id-type="GRID">grid.417651.0</institution-id><institution-id institution-id-type="ISNI">0000 0001 2156 6183</institution-id><institution>Laboratory of Medical-Surgical, Biomedicine and Infectiology Research, Faculty of Medicine and Pharmacy, </institution><institution>Ibnou Zohr University, </institution></institution-wrap>Agadir, Morocco </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/006sgpv47</institution-id><institution-id institution-id-type="GRID">grid.417651.0</institution-id><institution-id institution-id-type="ISNI">0000 0001 2156 6183</institution-id><institution>Laboratory of Aquatic Systems: Marine and Continental Ecosystems, Faculty of Sciences, </institution><institution>Ibnou Zohr University, </institution></institution-wrap>Agadir, Morocco </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/00e5k0821</institution-id><institution-id institution-id-type="GRID">grid.440573.1</institution-id><institution-id institution-id-type="ISNI">0000 0004 1755 5934</institution-id><institution>Center for Genomics and Systems Biology, </institution><institution>New York University Abu Dhabi, </institution></institution-wrap>Abu Dhabi, United Arab Emirates </aff></contrib-group><pub-date pub-type="epub"><day>1</day><month>11</month><year>2024</year></pub-date><pub-date pub-type="pmc-release"><day>1</day><month>11</month><year>2024</year></pub-date><pub-date pub-type="collection"><year>2024</year></pub-date><volume>14</volume><elocation-id>26328</elocation-id><history><date date-type="received"><day>24</day><month>5</month><year>2024</year></date><date date-type="accepted"><day>16</day><month>10</month><year>2024</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2024</copyright-statement><copyright-year>2024</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><p id="Par1">Water scarcity has evolved into a pressing global issue, significantly impacting numerous regions worldwide. The use of treated wastewater stands out as a promising solution to this problem. However, the proliferation of various contaminants, primarily Antimicrobial Resistance Genes (ARGs), poses a significant challenge to its safe and sustainable use. In this study, we assessed the composition and abundance of 373 ARGs, corresponding to 31 different classes of antibiotics, in six wastewater treatment plants (WWTP) in Agadir city of Morocco. Influent and effluent samples were collected during the months of February and July in 2020, in addition to samples from the Atlantic Ocean. In total, 223 ARGs were uncovered, highlighting in particular resistance to aminoglycoside, macrolide lincosamide, beta-lactamase, chloramphenicol, sulfonamide, tetracycline, and other antibiotics. The mechanisms of action of these ARGs were mainly antibiotic inactivation, antibiotic target alteration, efflux pump and cellular protection. Mobile genetic elements (MGEs) were detected at high levels their co-occurrence with ARGs highlights their involvement in the acquisition and transmission of ARGs in microbial communities through horizontal gene transfer. While many wastewater treatment methods effectively reduce a large proportion of gene material and pathogens, a substantial fraction of ARGs and other contaminants persist in treated wastewater. This persistence poses potential risks to both human health and the environment, warranting the need of more effective treatment strategies.</p></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Water scarcity</kwd><kwd>Wastewater</kwd><kwd>Antimicrobial resistance genes</kwd><kwd>Microbiome</kwd><kwd>Public Health</kwd></kwd-group><kwd-group kwd-group-type="npg-subject"><title>Subject terms</title><kwd>Environmental sciences</kwd><kwd>Next-generation sequencing</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer Nature Limited 2024</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1" sec-type="introduction"><title>Introduction</title><p id="Par2">Water scarcity has become an increasingly urgent global issue, deeply impacting regions around the world and affecting billions of lives<sup><xref ref-type="bibr" rid="CR1">1</xref></sup>. This shortage stems from a complex interplay of factors, such as population expansion, climate change, ineffective water management, and pollution. Climate change is intensifying the issue of water scarcity by disrupting rainfall patterns and amplifying the frequency and severity of droughts and floods<sup><xref ref-type="bibr" rid="CR2">2</xref></sup>. These changes disrupt the natural water cycle, leading to irregularities in water availability and distribution<sup><xref ref-type="bibr" rid="CR3">3</xref></sup>.</p><p id="Par3">In addressing water scarcity, various strategies are employed worldwide. Among these strategies, one particularly crucial approach is the reuse of treated wastewater. This method involves treating wastewater to remove contaminants, transforming it into a valuable resource for non-potable purposes. Advanced treatment technologies ensure that recycled water meets quality standards, making it safe for applications such as irrigation, industrial processes, and even toilet flushing<sup><xref ref-type="bibr" rid="CR4">4</xref></sup>. By employing recycled water for these activities, pressure on traditional water sources is reduced, contributing to water conservation efforts. Embracing wastewater reuse as a sustainable solution supports the efficient management of water resources, promoting environmental and economic sustainability<sup><xref ref-type="bibr" rid="CR5">5</xref></sup>.</p><p id="Par4">However, the reuse of treated wastewater for various purposes, while beneficial in addressing water scarcity, raises concerns about the emergence of new contaminants, particularly antimicrobial resistance (AMR) genes. It can contain residues of pharmaceuticals, including antibiotics, and other antimicrobial agents. These antimicrobial substances can exert selective pressure on bacteria present in the environment, promoting the development and spread of resistance, which can be transferred to other bacteria through horizontal gene transfer mechanisms<sup><xref ref-type="bibr" rid="CR6">6</xref></sup>. The presence of AMR genes in recycled wastewater poses risks to public health, as it can lead to the dissemination of antibiotic-resistant bacteria and compromise the effectiveness of antibiotics in medical treatment. A recent study examined the metagenomic insights into the wastewater resistome in large-scale wastewater treatment plants (WWTPs) across Moscow city revealed that treated effluent continued to contain AMR genes, with a notable prevalence of those associated with beta-lactamases. Among these ARGs, <italic>ampC</italic> was identified as the most abundant, even after the purification process<sup><xref ref-type="bibr" rid="CR7">7</xref></sup>. Another study indicates that wastewater treatment effectively eliminates the hosts of antibiotic resistance genes, leading to a subsequent reduction in the presence of harbored antibiotic resistance genes<sup><xref ref-type="bibr" rid="CR8">8</xref></sup>.</p><p id="Par5">To address the emergence of those new contaminants, comprehensive monitoring and treatment protocols are essential. This involves implementing advanced technologies capable of removing a wide range of contaminants. Additionally, ongoing surveillance programs can track the presence and prevalence of AMR genes in wastewater, assessing potential risks to public health and the environment<sup><xref ref-type="bibr" rid="CR9">9</xref>,<xref ref-type="bibr" rid="CR10">10</xref></sup>.</p><p id="Par6">In this context, Morocco faces significant challenges regarding water scarcity, particularly in regions with limited freshwater resources and growing water demand. The country&#x02019;s arid and semi-arid climate exacerbates the problem, leading to water stress and shortages, especially during prolonged droughts. To address water scarcity, Morocco has been increasingly exploring the reuse of treated wastewater as sustainable solutions. However, the lack of comprehensive studies evaluating the quality of treated wastewater poses challenges, especially concerning the potential risks associated with antimicrobial resistance. Comprehensive studies evaluating the presence and persistence of AMR genes in treated wastewater are crucial for informing decision-making and implementing effective mitigation strategies. This can enhance water security, protect public health, and contribute to global efforts to combat AMR. This study presents a spatiotemporal characterization of the resistome and microbiome across different wastewater treatment plants in Agadir city during two distinct seasons, with samples collected from the ocean. Additionally, it includes a comparative evaluation of the efficacy of various purification treatments deployed at each facility.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Samples collection</title><p id="Par7">In February and July 2020, samples of both untreated wastewater and treated wastewater were collected from six wastewater treatment plants. These plants include M&#x02019;ZAR, ANZA, AOURIR, DRARGA, TIZNIT, and AIT BAHA WWTPs (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>). A volume of 1&#x000a0;L was collected from both untreated and treated water samples.</p><p id="Par8">
<fig id="Fig1"><label>Fig. 1</label><caption><p>Map displaying sampling sites created using ArcGIS (version 3.3; <ext-link ext-link-type="uri" xlink:href="https://www.esri.com/en-us/arcgis/products/arcgis-pro/overview">https://www.esri.com/en-us/arcgis/products/arcgis-pro/overview</ext-link>).</p></caption><graphic xlink:href="41598_2024_76773_Fig1_HTML" id="d33e289"/></fig>
</p><p id="Par9">The wastewater treatment plants employ various processes for wastewater treatment, as detailed in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>. The anaerobic decantation process relies on bacteria to break down organic matter in the absence of oxygen, producing biogas, and is suited for high-strength wastewater. Activated sludge process uses aerobic microorganisms to degrade organic material in the presence of oxygen, typically in municipal wastewater treatment. Lamellar decantation enhances sedimentation efficiency using inclined plates, allowing suspended solids to settle more quickly. Infiltration-percolation on sand involves filtering wastewater through sand beds, offering a natural filtration method. Naturally aerobic lagoons are shallow ponds where microorganisms, aided by sunlight and wind, treat wastewater through aerobic processes, but they require large land areas and extended retention times.</p><p id="Par10">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Treatments used in studied WWTPs.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">WWTP</th><th align="left">Type of treatment</th><th align="left">Role of treatment</th></tr></thead><tbody><tr><td align="left">M&#x02019;ZAR (MZ)</td><td align="left"><p>Anaerobic decantation</p><p>(A.decantation)</p></td><td align="left">Eliminates a significant portion of suspended matter.</td></tr><tr><td align="left">AOURIR (AR)</td><td align="left"><p>Activated sludge process</p><p>(A.sludge)</p></td><td align="left">Wastewater is mixed and agitated with highly active bacteriological sludge. Degradation takes place under aerobic conditions, utilizing a combination of purifying microorganisms and the influent to be treated</td></tr><tr><td align="left">ANZA (AZ)</td><td align="left"><p>Lamellar decantation</p><p>(L.decantation)</p></td><td align="left">Clears water by isolating and removing suspended particles</td></tr><tr><td align="left">DRARGA (DR)</td><td align="left"><p>Infiltration-Percolation on sand</p><p>(In-Per on sand)</p></td><td align="left">This involves channeling previously settled wastewater through a porous mass of materials, serving as a substrate for purifying microorganisms.</td></tr><tr><td align="left">TIZNIT (TZ) and AIT BAHA (AB)</td><td align="left"><p>Naturally Aerobic Lagoons</p><p>(N.Aer Lagoons)</p></td><td align="left">Wastewater resides within basins for a defined period, during which bacterial action within the water degrades pollutants. Solar radiation contributes to the destruction of certain microorganisms</td></tr></tbody></table></table-wrap>
</p><p id="Par11">Sampling was exclusively conducted in February for the AIT BAHA station, as the facility underwent temporary closure in July for maintenance purposes. Additionally, water samples were procured from two beaches in July period, ANZA and SIDI TOUAL. To serve as an external control for the experiment, a sample from the TAMZERGOUT river was collected. Subsequently, all 26 gathered samples were carefully transported to the laboratory, ensuring preservation in a cooler set at 4&#x000a0;&#x000b0;C.</p></sec><sec id="Sec4"><title>Physico-chemical parameters</title><p id="Par12">In-situ measurements of physicochemical parameters encompassed temperature, pH, conductivity, salinity, and dissolved oxygen. These measurements were conducted utilizing a multiparameter device, the Multi 340i by Geotech Environmental Equipment. Laboratory-scale measurements involved turbidity and chemical oxygen demand (COD). Turbidity was assessed using a turbidimeter (LOVIBOND TB300 IR), while the Hanna instrument micro method (Hanna Instruments, USA) was employed for COD determination. The quantification of Calcium, Chlorides, Magnesium, Water Hardness, and content of Carbonates and Bicarbonates (TAC) employed volumetric titration methods<sup><xref ref-type="bibr" rid="CR11">11</xref></sup>. Calcium and Magnesium, which contribute to water hardness, were measured together using EDTA titration, where EDTA binds with these ions to form a stable complex. Chlorides were quantified by argentometric titration, involving the reaction of chloride ions with silver nitrate. The content of Carbonates and Bicarbonates was determined by acid-base titration, where the sample was titrated with a strong acid to a specific pH, indicating the total alkalinity. Heavy metal analysis took place at the Mitra S. K Morocco SARL laboratory (Mitra S.K, Agadir, Morocco). The array of heavy metals measured encompasses Zinc, Antimony, Cadmium, Aluminum, Lead, Copper, Cadmium, Iron, Manganese, Strontium, Arsenic, and Mercury. To measure heavy metals such as Zinc, Antimony, Cadmium, Aluminum, Lead, Copper, Iron, Manganese, Strontium, Arsenic, and Mercury, Atomic Absorption Spectroscopy (AAS) is used. First, the sample is prepared by digesting it with strong acids to release the metals into solution. The sample is then analyzed using AAS, where it is atomized and exposed to light. Each metal absorbs light at specific wavelengths, and the amount of light absorbed is proportional to the metal&#x02019;s concentration in the sample. Calibration curves, created from standards of known concentrations, are used to quantify the metal concentrations accurately<sup><xref ref-type="bibr" rid="CR12">12</xref></sup>.</p></sec><sec id="Sec5"><title>DNA extraction, Metagenomic Sequencing and Bioinformatic Analysis</title><p id="Par13">Initially, the wastewater underwent a pre-treatment. Duplicate volumes of 90&#x000a0;ml were subjected to centrifugation at 4000&#x000a0;g, held at 4&#x000a0;&#x000b0;C for 20&#x000a0;min. Subsequently, the resulting pellet was recovered, subjected to a wash with phosphate<italic>-</italic>buffered saline (PBS), and processed using the QIAamp PowerFecal ProDNA Kit (Qiagen, Hilden, Germany) in accordance with the kit&#x02019;s extraction protocol. For the water samples collected from ANZA and SIDI TOUAL beaches, they underwent a filtration process of 1&#x000a0;L utilizing a 0.45&#x000a0;&#x003bc;m filter. Following filtration, the filter was segmented into smaller sections and then subjected to treatment using the mentioned extraction kit. Quantification of the extracted DNA was achieved through both a DeNovix DS-11 spectrophotometer and Qubit (HS ds DNA test kit).</p><p id="Par14">To check the quality of the extracted DNA and verify that it does not contain PCR inhibitors, 16S PCR was performed. The 16S rRNA gene was amplified using universal primers <italic>Fd1</italic> (5&#x02032;-AGAGTTTGATCCTGGCTCAG-3&#x02032;) and <italic>rP2</italic> (5&#x02032;-ACGGCTACCTTGTTACGACTT-3&#x02019;)<sup><xref ref-type="bibr" rid="CR13">13</xref></sup>. PCR amplification was carried out in a final volume of 15&#x000a0;&#x000b5;l containing 7,8&#x000a0;&#x000b5;l nuclease Free water, 3&#x000a0;&#x000b5;l of MyTaq Reaction Buffer, 0,2&#x000a0;&#x000b5;l MyTaq&#x02122; DNA Polymerase (MyTaq&#x02122; DNA Polymerase, Bioline Reagents Ltd, Meridian Bioscience) and 1&#x000a0;&#x000b5;l of primers (10 pmoles) and 3&#x000a0;&#x000b5;l (10ng) of DNA template. The PCR started with an initial denaturation of 2&#x000a0;min at 95&#x000a0;&#x000b0;C, followed by 30 denaturation cycles at 95&#x000a0;&#x000b0;C for 15&#x000a0;s, hybridization at 52&#x000a0;&#x000b0;C for 30&#x000a0;s, extension at 72&#x000a0;&#x000b0;C for 1&#x000a0;min, and a final elongation step for 7&#x000a0;min at 72&#x000a0;&#x000b0;C. PCR products (10 &#x000b5;L of PCR products) were transferred to a 1% agarose gel in TBE migration buffer (Tris, Borate, EDTA). The Ion AmpliSeq&#x02122; Pan-Bacterial Research Panel from Thermo Fisher Scientific was employed to characterize the resistome and microbiomeo of samples. The panel contained two pools. The first pool contained 269 amplicons to track 21 specific species and 716 amplicons to detect 364 antibiotic resistance genes belonging to 31 different antibiotic classes. The second pool contained 24 amplicons that were used to characterize the 16&#x000a0;S profile. The library was prepared with ION CHEF (Ion Chef&#x02122; Instrument - Thermo Fisher Scientific) using the Ion Ampliseq kit for chef DL8 (Ion AmpliSeq&#x02122; Kit for Chef DL8 - Thermo Fisher Scientific). The concentration was set at 10 ng in a 15 &#x000b5;L reaction volume. For automated library preparation, R&#x00026;D recommends cycling the two pools separately under the following conditions:</p><p id="Par15">
<list list-type="bullet"><list-item><p id="Par16">Pool 1 (SpID/AMR): 985 amplicons with 15 cycles and a 4-minute annealing time.</p></list-item><list-item><p id="Par17">Pool 2 (16&#x000a0;S): 24 amplicons with 21 cycles and a 4-minute annealing time.</p></list-item></list>
</p><p id="Par18">For DL8 adjustments, an additional cycle is typically added to the target amplification, but the pools are run on separate automated Chef DL8 runs.</p><p id="Par19">The library was subsequently quantified by the Ion Library TaqMan Quantitation Kit (Ion Library TaqMan&#x02122; Quantitation Kit - Thermo Fisher Scientific). The samples were prepared and subsequently loaded onto a 540-chip using an Ion Chef system. After loading, the chips were sequenced using the Ion GeneStudio S5 system (Ion GeneStudio&#x02122; S5 System - Thermo Fisher Scientific). Bioinformatics analysis was performed using the Torrent Suite plugin under the name &#x000ab; Pan Bacterial Analysis &#x000bb;. This plugin is available on the ThermoFisher Scientific Plugin store.</p></sec><sec id="Sec6"><title>qPCR of additional antimicrobial resistance genes</title><p id="Par20">The analysis panel employed did not cover certain crucial genes that present a notable threat to public health. The focus was on genes such as <italic>blaNDM</italic>,<italic> blaCTX</italic>,<italic> blaVIM</italic>,<italic> blaOXA-48</italic>,<italic> blaKPC</italic>,<italic> blaSHV</italic>,<italic> blaIMP</italic>, and <italic>mcr-1</italic>. To standardize the gene copy counts, 16&#x000a0;S qPCR was conducted<sup><xref ref-type="bibr" rid="CR14">14</xref></sup>. The primers used to detect these genes are listed in the Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>.</p><p id="Par21">
<table-wrap id="Tab2"><label>Table 2</label><caption><p>Primers used for quantitative PCR of other resistance genes.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Target Gene</th><th align="left">Primer</th><th align="left">Sequence (5&#x02019;-3&#x02019;)</th><th align="left">Reference</th></tr></thead><tbody><tr><td align="left">
<italic>blaNDM</italic>
